{
  "name": "agentic-app-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"pnpm --filter @app/server dev\" \"pnpm --filter @app/web dev\"",
    "build": "pnpm --filter @app/web build && pnpm --filter @app/server build",
    "start": "pnpm --filter @app/server start",
    "typecheck": "pnpm typecheck:src && pnpm typecheck:modules && pnpm typecheck:e2e",
    "typecheck:src": "tsc -p tsconfig.json --noEmit",
    "typecheck:modules": "node scripts/typecheck-modules.mjs",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "migrate": "pnpm --filter @app/server migrate",
    "seed": "pnpm --filter @app/server seed",
    "reset": "rm -rf data && pnpm migrate && pnpm seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:model": "APP_E2E_MODEL=1 playwright test",
    "evidence": "APP_WRITE_EVIDENCE=1 vitest run tests/measurements.test.ts tests/diagnostics.test.ts",
    "evidence:z5": "APP_WRITE_EVIDENCE=1 vitest run tests/app-context.test.ts",
    "evidence:e2e": "APP_WRITE_EVIDENCE=1 playwright test e2e/measurements.spec.ts e2e/streaming.spec.ts e2e/view-filter.spec.ts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:acceptance": "node scripts/acceptance-matrix.mjs --check",
    "acceptance:render": "node scripts/acceptance-matrix.mjs",
    "check:module-swap": "node scripts/check-module-swap.mjs",
    "verify": "pnpm check:boundaries && pnpm check:acceptance && pnpm check:matrix && pnpm check:closure && pnpm typecheck && pnpm build && pnpm test",
    "diag": "pnpm --filter @app/server diag",
    "acceptance": "node scripts/acceptance-agent.mjs",
    "check:matrix": "node scripts/matrix-summary.mjs --check",
    "check:closure": "node scripts/closure-matrix.mjs --summary > /dev/null",
    "backup": "node scripts/backup-state.mjs",
    "backup:verify": "node scripts/backup-state.mjs --verify",
    "migration:rehearsal": "node scripts/migration-rehearsal.mjs",
    "restore": "node scripts/restore-state.mjs",
    "restore:check": "node scripts/restore-state.mjs --check",
    "synthetic:state": "node scripts/synthetic-state.mjs"
  },
  "devDependencies": {
    "@app/server": "workspace:*",
    "@hono/node-server": "1.19.7",
    "@mastra/core": "1.66.0",
    "@module/devkit-probe": "workspace:*",
    "@module/procurement": "workspace:*",
    "@openuidev/react-headless": "0.9.13",
    "@platform/contracts": "workspace:*",
    "@platform/server": "workspace:*",
    "@platform/ui": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tanstack/react-query": "5.102.8",
    "@types/node": "24.10.2",
    "concurrently": "9.2.1",
    "esbuild": "0.27.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "zod": "4.6.5"
  }
}
